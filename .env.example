# ==============================================================================
# VANN SITHA AI SALE STUDIO - ENVIRONMENT VARIABLES TEMPLATE
# (ចម្លងឯកសារនេះទៅជា .env រួចបំពេញព័ត៌មានខាងក្រោម)
# ==============================================================================

# ១. Database Connection (Supabase PostgreSQL)
# បង្កើតគម្រោង Free នៅលើ https://supabase.com យក Connection String
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ២. AI Engine (Google Gemini API Key)
# យក Key ឥតគិតថ្លៃពី https://aistudio.google.com
GEMINI_API_KEY="AIzaSy..."

# ៣. Facebook Page & Graph API Configuration
# យក Page ID និង Page Access Token ពី Facebook Developer / Page Settings
FB_PAGE_ID="955747057621489"
FB_PAGE_ACCESS_TOKEN="EAA..."
FB_VERIFY_TOKEN="vannsitha_ai_secure_verify_token_2026"

# ៤. Session & Security Secret
JWT_SECRET="vannsitha_super_secure_jwt_secret_random_key_2026"

# ៥. Telegram Bot Alert (ជម្រើសបន្ថែម - សម្រាប់ជូនដំណឹងទៅទូរស័ព្ទ)
# បង្កើត Bot តាម @BotFather ក្នុង Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ៦. Production App URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
